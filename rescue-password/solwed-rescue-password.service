[Unit]
Description=Solwed OS - registro de contrasena de rescate soporte-solwed en primer arranque
After=network-online.target rustdesk.service
Wants=network-online.target
ConditionPathExists=!/var/lib/solwed/rescue-password-done

[Service]
Type=oneshot
EnvironmentFile=/etc/solwed/rescue-password.env
ExecStart=/usr/lib/solwed/report-rescue-password.sh
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
