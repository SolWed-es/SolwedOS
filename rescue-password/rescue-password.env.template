# Plantilla — copiar a /etc/solwed/rescue-password.env en la imagen (custom-root)
# con el valor real, NUNCA commitear el token real en este repo ni pegarlo en un
# chat (mismo criterio que las claves de RustDesk/GPG del proyecto).
#
# Este token solo permite REGISTRAR una contraseña nueva para un rustdesk_id
# que el servidor no conozca todavía (ver server/app.py: INSERT falla con 409
# si el id ya existe) — no permite leer contraseñas ya guardadas. Por eso es
# aceptable que sea el mismo valor horneado en todas las imágenes: si se
# filtra, lo peor que permite es registrar entradas para IDs nuevos, nunca
# sobrescribir ni leer las de máquinas ya registradas.
DEVICE_TOKEN=cambia-este-valor-antes-de-hornear-la-imagen
